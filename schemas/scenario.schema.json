{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Keyu Harness synthetic scenario",
  "type": "object",
  "required": [
    "scenario_id",
    "title",
    "notice",
    "kind"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "notice": {
      "type": "string",
      "pattern": "^(FICTIONAL|SYNTHETIC)"
    },
    "kind": {
      "enum": [
        "artifact_identity_check",
        "trace_anomaly"
      ]
    },
    "trace_csv": {
      "type": "string"
    },
    "thresholds": {
      "type": "object"
    },
    "artifacts": {
      "type": "array"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "data_class": {
            "enum": [
              "SIMULATED"
            ]
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "data_class"
        ]
      }
    }
  },
  "additionalProperties": true
}
